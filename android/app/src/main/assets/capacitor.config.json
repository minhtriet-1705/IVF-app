{
	"appId": "app.sandrasoft.ivf",
	"appName": "MyIVF",
	"webDir": "dist",
	"bundledWebRuntime": false,
	"server": {
		"allowNavigation": [
			"*"
		]
	},
	"plugins": {
		"Keyboard": {
			"resize": "native",
			"style": "dark",
			"resizeOnFullScreen": true
		},
		"PushNotifications": {
			"presentationOptions": [
				"badge",
				"sound",
				"alert"
			]
		},
		"CapacitorFirebaseAuth": {
			"providers": [
				"google.com",
				"phone"
			],
			"languageCode": "en",
			"nativeAuth": true,
			"properties": {
				"google": {}
			},
			"permissions": {
				"google": [
					"profile"
				]
			}
		}
	}
}
